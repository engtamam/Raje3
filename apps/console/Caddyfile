# The console's own server, inside the cluster. The edge in front of it — also Caddy — owns TLS and
# the hostnames; this one only decides which file answers which path.
:8080 {
	root * /srv
	encode gzip

	respond /healthz 200 {
		body "ok"
	}

	# ── WHY A SHIPPED SCREEN KEPT NOT ARRIVING ────────────────────────────────────────────────
	#
	# Nothing here set Cache-Control, so a browser applied its own heuristic to `index.html` and
	# served it from disk without asking us. And index.html is the ONLY file that names the bundle:
	# every build writes `assets/index-<hash>.js`, and the page that points at it is the page the
	# browser had already decided it did not need to re-fetch. So a deployment rolled, the pod
	# reported the new digest, `verify-fleet` agreed, and the owner opened the console and saw the
	# old screen — with no way to know a hard refresh was the missing step, and no reason to guess.
	#
	# Tamam hit it twice in one night: «الشحن غير صحيح ما زالت الواجهة نفسها», on a cluster that
	# was running exactly what the repository declared.
	#
	# TWO RULES, AND THEY ARE OPPOSITES ON PURPOSE:
	#
	#   the HTML is never trusted from cache — it is small, it is the entry point, and it is the
	#   one file whose staleness hides everything else;
	#
	#   the hashed assets are trusted for a year — their NAME contains a hash of their content, so
	#   a changed file is a different URL and there is nothing to invalidate. Re-validating them
	#   would spend a round trip per asset on every load to be told nothing changed.
	# MATCHED ON WHAT IS NOT AN ASSET, NOT ON A LIST OF PAGES. Every screen has a real URL and the
	# rewrite below serves index.html for all of them — `/app/shop`, `/app/customers/42` — so a
	# matcher naming the html paths would have covered the two a person never types and missed
	# every one he does.
	@asset path /assets/* /app/assets/*
	header @asset Cache-Control "public, max-age=31536000, immutable"
	@page not path /assets/* /app/assets/*
	header @page Cache-Control "no-cache"

	# SPA ROUTING IS NOT OPTIONAL HERE. Every screen has a real URL — a customer page arrives as a
	# link inside a WhatsApp message — and reloading one of those is a request with no file behind
	# it. Without the rewrite the owner sees 404 on a screen that works perfectly when navigated to.
	# /app WITHOUT THE SLASH IS NOT /app/ — and the reader who types it, or the link that omits it,
	# lands on the landing page instead of the console with no error anywhere. `handle /app/*` does
	# not match the bare path; only a redirect makes the two names one place.
	# AND THE QUERY SURVIVES THE REDIRECT. `redir /app /app/` drops everything after the question
	# mark, so ?signup=1 — the one link on the landing page that means «I want an account» — arrived
	# at the console as a plain visit, and the sign-up form never opened. Two matchers, because a
	# bare /app must not redirect to a URL ending in a lonely question mark.
	@app_bare path /app
	@app_bare_q {
		path /app
		expression {query} != ""
	}
	redir @app_bare_q /app/?{query} permanent
	redir @app_bare /app/ permanent

	handle /app/* {
		try_files {path} /app/index.html
		file_server
	}

	# AFFILIATES.<DOMAIN> HAS NO LANDING PAGE OF ITS OWN — main.tsx's `isAffiliateHost` branch
	# (mounting AffiliatePortal at basename '/') can only ever run once the app bundle has loaded,
	# and nothing above this point tells THIS server that a request for `/` on that hostname wants
	# the app rather than the marketing site. Every visit to https://affiliates.<domain>/ fell
	# through to the same `handle {}` below as the shop's own domain and rendered the marketing
	# landing page — the app's own hostname check never got the chance to run.
	#
	# The edge (deploy/edge/edge.json) already puts both hostnames on one Caddy site block with no
	# host-based routing at all (see bring-up.sh's own comment on `aliases`); the branch has to live
	# HERE, the one server that already knows the difference between the app and the landing page.
	@affiliate_host {
		header_regexp affiliate_host Host ^affiliates\.
		not path /app/*
	}
	handle @affiliate_host {
		try_files {path} /app/index.html
		file_server
	}

	# SAME BUG, SAME FIX, admin.<domain> — main.tsx's `isAdminHost` branch has existed since before
	# this file's own affiliate_host block was added, and was never given the matching server-side
	# half: every visit to https://admin.<domain>/ fell through to the marketing landing page below,
	# confirmed live (curl returned the landing page's own HTML, not the SPA shell) — the exact
	# defect this file's comment above already named and explained, just not closed for this host.
	@admin_host {
		header_regexp admin_host Host ^admin\.
		not path /app/*
	}
	handle @admin_host {
		try_files {path} /app/index.html
		file_server
	}

	# THE LANDING-PAGE OFF-SWITCH — "stealth" launch mode, requested so the root domain can be
	# handed to a private cohort (invited by direct link, never able to reach sign-up on their own)
	# without deleting the landing page: `LANDING_PAGE_ENABLED=false` on this Deployment (see
	# deploy/edge/console.yaml's own env entry) sends `/` itself straight to the console door — the
	# ONE bare path a person actually types or a bookmark points at. Every OTHER path on this
	# domain is unaffected: the SPA's own real screens, `/app/*`, still work exactly as they always
	# have, and a link straight into the marketing page (e.g. `/#pricing`) still 404s the same way
	# it would with the flag off, since this only ever matches the bare root.
	#
	# `{$LANDING_PAGE_ENABLED:true}` is a Caddyfile TEXT SUBSTITUTION, resolved once when this
	# config loads (container start), not per request — flipping it is a redeploy, never a
	# runtime toggle a request header could influence.
	@landing_off {
		path /
		expression `"{$LANDING_PAGE_ENABLED:true}" == "false"`
	}
	redir @landing_off /app permanent

	# The landing page at the root, same origin as the console, so a link from one into the other is
	# not a cross-site anything.
	handle {
		try_files {path} /index.html
		file_server
	}
}
