# The console's own server, inside the cluster. The edge in front of it — also Caddy — owns TLS and
# the hostnames; this one only decides which file answers which path.
:8080 {
	root * /srv
	encode gzip

	respond /healthz 200 {
		body "ok"
	}

	# SPA ROUTING IS NOT OPTIONAL HERE. Every screen has a real URL — a customer page arrives as a
	# link inside a WhatsApp message — and reloading one of those is a request with no file behind
	# it. Without the rewrite the owner sees 404 on a screen that works perfectly when navigated to.
	# /app WITHOUT THE SLASH IS NOT /app/ — and the reader who types it, or the link that omits it,
	# lands on the landing page instead of the console with no error anywhere. `handle /app/*` does
	# not match the bare path; only a redirect makes the two names one place.
	# AND THE QUERY SURVIVES THE REDIRECT. `redir /app /app/` drops everything after the question
	# mark, so ?signup=1 — the one link on the landing page that means «I want an account» — arrived
	# at the console as a plain visit, and the sign-up form never opened. Two matchers, because a
	# bare /app must not redirect to a URL ending in a lonely question mark.
	@app_bare path /app
	@app_bare_q {
		path /app
		expression {query} != ""
	}
	redir @app_bare_q /app/?{query} permanent
	redir @app_bare /app/ permanent

	handle /app/* {
		try_files {path} /app/index.html
		file_server
	}

	# The landing page at the root, same origin as the console, so a link from one into the other is
	# not a cross-site anything.
	handle {
		try_files {path} /index.html
		file_server
	}
}
