!.env.example
# Build artifacts — compiled from data/, never committed
# Env / secrets — never commit real values
# Generated + secret-bearing cluster manifests — never commit
# Node
# OS / editor
# Python
# test harness output
*.py[cod]
*.tsbuildinfo
.DS_Store
.env
.env.*
.idea/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.test-logs/
.venv/
.vite/
.vscode/
Thumbs.db
__pycache__/
build/
deploy/server/manifests/**/*secrets*.json
node_modules/
services/*/.pytest_cache/
services/*/.venv/
services/operations/.venv/
# `uv run` writes this the first time it's invoked in a service dir it hasn't touched before —
# found live: an untracked uv.lock made publish-images.sh build from "a tree with uncommitted
# changes" every time, so the same source produced a DIFFERENT image digest on every ship, and a
# follow-up ship of the same commit failed verify (RUNNING one digest, pinned another, confirmed
# different content) purely because the lock file's own presence/absence flipped the build.
services/*/uv.lock
venv/
node_modules/
apps/*/dist/
# Playwright artefacts — screenshots and traces of a run, never source.
apps/console/test-results/
apps/console/playwright-report/
apps/console/e2e/.session.json
apps/console/e2e/.session.phone
apps/console/e2e/.import-session.json

# The deploy bundle pack.sh builds. A build artefact: it is rebuilt from the tree on
# demand, and committing it would put a stale copy of every values file in the history.
dist/

# names a host and a login — per operator, never shared
deploy/target.env

# PRIVATE KEYS ARE NEVER TRACKED (ج2-أ). `pilot.pem` — the SSH key to the pilot server — was
# committed in 3b997bc and travelled to origin. The repository is private, so the exposure is
# bounded by who can read it, but a key in a history is a key that cannot be un-shared: the
# containment is ROTATION on the server, which is Tamam's to do, not a deletion here.
*.pem
*.key
id_rsa
id_ed25519

# LOAD-TEST RUN OUTPUT (media/tours/) — .loadtest-tenants.json holds REAL minted access tokens
# (owner-capability JWTs) for whatever tenants a local load-test run created; found sitting
# untracked in the working tree with a live-looking token still in it. Local, regenerated every
# run, never meant to leave this machine — same reasoning as *.pem above, a secret in history
# cannot be un-shared even after deletion.
media/tours/.loadtest-result.json
media/tours/.loadtest-tenants.json

# docs/ is scratch/working notes, never product source — untracked entirely (2026-09-19, owner's
# own instruction) so a stray plan/audit file never shows up as "uncommitted changes" noise on
# every ship.
docs/
